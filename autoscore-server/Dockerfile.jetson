# Dockerfile for NVIDIA Jetson with CUDA support
# Base image: l4t-pytorch:r36.4.0 includes:
# - JetPack 6.2 (L4T R36.4.0)
# - PyTorch 2.7 with CUDA 12.8 support
# - Python 3.12
# - Pre-built with cuDNN, CUDA toolkit, and optimized for Jetson hardware
# - numpy, opencv (via apt), and other common ML packages

FROM dustynv/l4t-pytorch:r36.4.0

WORKDIR /app

# Copy application code
COPY autoscore/ ./autoscore/
COPY detector/ ./detector/

# Install Python dependencies
# Note: PyTorch, numpy, and opencv are already installed in the base image
# We install only the missing packages with relaxed version constraints
# to ensure compatibility with ARM64 architecture
RUN pip3 install --no-cache-dir \
    click \
    pydanclick \
    pydantic \
    pydantic-settings \
    websockets \
    ultralytics || \
    # Fallback: try installing ultralytics without dependencies
    # since torch/numpy/opencv are already present
    pip3 install --no-cache-dir --no-deps ultralytics

# Clean up to reduce image size
RUN rm -rf /tmp/* /var/tmp/* ~/.cache/pip

# Expose WebSocket port
EXPOSE 8765

# Set environment variables
ENV AUTOSCORE_HOST=0.0.0.0
ENV AUTOSCORE_PORT=8765

# Run the autoscore server
CMD ["python3", "-m", "autoscore.main"]
