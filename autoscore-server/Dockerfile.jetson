# Dockerfile for NVIDIA Jetson with CUDA support
# Base image: l4t-pytorch:r36.4.0 includes:
# - JetPack 6.2 (L4T R36.4.0)
# - PyTorch 2.7 with CUDA 12.8 support
# - Python 3.12
# - Pre-built with cuDNN, CUDA toolkit, and optimized for Jetson hardware

FROM dustynv/l4t-pytorch:r36.4.0

WORKDIR /app

# Copy application code
COPY autoscore/ ./autoscore/
COPY detector/ ./detector/

# Upgrade pip and setuptools to meet ultralytics requirements
RUN pip3 install --no-cache-dir --upgrade \
    --extra-index-url https://pypi.org/simple \
    pip setuptools>=70.0.0 wheel

# Install Python dependencies from PyPI (not Jetson repos)
# The base image already includes PyTorch, numpy, opencv with CUDA support
# We need to use --extra-index-url to access standard PyPI for packages not in Jetson repos
RUN pip3 install --no-cache-dir \
    --extra-index-url https://pypi.org/simple \
    click>=8.2.1 \
    pydanclick>=0.5.1 \
    pydantic>=2.11.5 \
    pydantic-settings>=2.10.1 \
    websockets>=15.0.1

# Install ultralytics from GitHub (not available in Jetson pip index)
# This will use the PyTorch already installed in the base image
RUN pip3 install --no-cache-dir \
    --extra-index-url https://pypi.org/simple \
    git+https://github.com/ultralytics/ultralytics.git@v8.3.199

# Clean up to reduce image size
RUN rm -rf /tmp/* /var/tmp/* ~/.cache/pip

# Expose WebSocket port
EXPOSE 8765

# Set environment variables
ENV AUTOSCORE_HOST=0.0.0.0
ENV AUTOSCORE_PORT=8765

# Run the autoscore server
CMD ["python3", "-m", "autoscore.main"]
